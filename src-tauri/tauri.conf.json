{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "VoxBridge Compose",
  "version": "0.1.1",
  "identifier": "com.voxbridge.compose",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxBridge Compose",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "visible": false,
        "closable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "publisher": "VoxBridge Compose contributors",
    "category": "Productivity",
    "copyright": "",
    "shortDescription": "GPU-first local transcription and composition",
    "longDescription": "Local-first voice capture with accelerated transcription and ordered composition agents",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.svg",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": [
      "engines-dist/**/*"
    ],
    "externalBin": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/com.voxbridge.compose.desktop.hbs",
        "depends": [
          "libgtk-layer-shell0",
          "libpulse0",
          "libappindicator3-1"
        ],
        "files": {
          "/usr/share/metainfo/com.voxbridge.compose.metainfo.xml": "com.voxbridge.compose.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "packaging/com.voxbridge.compose.desktop.hbs",
        "depends": [
          "gtk-layer-shell",
          "webkit2gtk4.1",
          "pulseaudio-libs",
          "libappindicator-gtk3"
        ],
        "files": {
          "/usr/share/metainfo/com.voxbridge.compose.metainfo.xml": "com.voxbridge.compose.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/metainfo/com.voxbridge.compose.metainfo.xml": "com.voxbridge.compose.metainfo.xml",
          "/usr/share/appdata/com.voxbridge.compose.appdata.xml": "com.voxbridge.compose.metainfo.xml"
        }
      }
    }
  },
  "plugins": {}
}
